# JobPilot — example environment file
# This project does not run. These values are placeholders that show the
# SHAPE of the configuration a real deployment would need, nothing more.

# --- Database (Supabase is the only database in this project) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sk-placeholder-not-a-real-key

# --- LLM provider used by the agent loop and the enrichment step ---
OPENAI_API_KEY=sk-placeholder-not-a-real-key
OPENAI_MODEL=gpt-placeholder-model

# --- Chat platform webhook (generic, no specific vendor implied) ---
CHAT_WEBHOOK_VERIFY_TOKEN=placeholder-verify-token
CHAT_PLATFORM_API_KEY=placeholder-chat-api-key

# --- Object storage for raw scraped postings, before they reach the queue ---
RAW_POSTINGS_BUCKET=jobpilot-raw-postings-demo

# --- Queue used to decouple scraping from enrichment ---
INGEST_QUEUE_URL=https://queue.example.com/jobpilot-ingest-demo

# --- Misc ---
LOG_LEVEL=INFO
