# Copy to .env and fill in real values for a working deployment.
# Every value below is a placeholder; nothing here is a live credential.

JOBPILOT_ENVIRONMENT=development
JOBPILOT_LOG_LEVEL=INFO
JOBPILOT_LOG_FORMAT=console

# Supabase / Postgres
JOBPILOT_SUPABASE_URL=https://your-project.supabase.co
JOBPILOT_SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
JOBPILOT_SUPABASE_ANON_KEY=replace-with-anon-key
JOBPILOT_DATABASE_POOL_MIN_SIZE=1
JOBPILOT_DATABASE_POOL_MAX_SIZE=10

# LLM provider
JOBPILOT_LLM_PROVIDER=openai
JOBPILOT_LLM_API_KEY=replace-with-llm-api-key
JOBPILOT_LLM_CHAT_MODEL=gpt-4o-mini
JOBPILOT_LLM_EMBEDDING_MODEL=text-embedding-3-small
JOBPILOT_LLM_EMBEDDING_DIMENSIONS=1536
JOBPILOT_LLM_REQUEST_TIMEOUT_SECONDS=30

# Object storage (raw scraped postings)
JOBPILOT_OBJECT_STORAGE_BUCKET=jobpilot-raw-postings
JOBPILOT_OBJECT_STORAGE_ENDPOINT=https://storage.example.com
JOBPILOT_OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
JOBPILOT_OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key

# Queue (ingestion + enrichment fan-out)
JOBPILOT_QUEUE_BACKEND=sqs
JOBPILOT_QUEUE_URL=https://queue.example.com/jobpilot-ingest
JOBPILOT_QUEUE_VISIBILITY_TIMEOUT_SECONDS=60
JOBPILOT_QUEUE_MAX_RECEIVE_COUNT=5

# Chat / webhook
JOBPILOT_WEBHOOK_SIGNING_SECRET=replace-with-webhook-secret
JOBPILOT_TURN_LEASE_SECONDS=45
JOBPILOT_AGENT_MAX_TURNS=6
JOBPILOT_AGENT_MAX_TOOL_CALLS_PER_TURN=4

# Ranking weights (must sum to 1.0)
JOBPILOT_RANKING_WEIGHT_SEMANTIC=0.45
JOBPILOT_RANKING_WEIGHT_RECENCY=0.15
JOBPILOT_RANKING_WEIGHT_SENIORITY_FIT=0.20
JOBPILOT_RANKING_WEIGHT_LOCATION_FIT=0.10
JOBPILOT_RANKING_WEIGHT_COMPLETENESS=0.10

# Rate limiting / retry
JOBPILOT_SCRAPER_RATE_LIMIT_TOKENS_PER_SECOND=2.0
JOBPILOT_SCRAPER_RATE_LIMIT_BUCKET_SIZE=10
JOBPILOT_RETRY_MAX_ATTEMPTS=5
JOBPILOT_RETRY_BASE_DELAY_SECONDS=0.5
JOBPILOT_RETRY_MAX_DELAY_SECONDS=20
